datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  SELLER
}

enum UserStatus {
  PENDING_APPROVAL
  ACTIVE
  REJECTED
}

model Store {
  id                     String    @id @default(uuid())
  name                   String
  code                   String    @unique
  ownerId                String
  createdAt              DateTime  @default(now())
  logoUrl                String?
  themeColor             String?   @default("#0f172a")
  phone                  String?
  greeting               String?
  email                  String?
  operationalCostPerHour Float     @default(0.0)
  users                  User[]
  products               Product[]
  orders                 Order[]
}

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  password           String
  role               Role       @default(SELLER)
  status             UserStatus @default(PENDING_APPROVAL)
  commissionPercent  Float      @default(0.0)
  maxDiscountPercent Float      @default(0.0)
  avatarUrl          String?
  resetToken         String?
  resetExpires       DateTime?

  storeId String?
  store   Store?  @relation(fields: [storeId], references: [id])

  ordersSold Order[]  @relation("SellerOrders")
  createdAt  DateTime @default(now())
}

model Customer {
  id              String   @id @default(uuid())
  name            String
  email           String   @unique
  document        String?
  phone           String?
  address         String?
  responsibleArea String?
  orders          Order[]
  createdAt       DateTime @default(now())
}

model Product {
  id                String  @id @default(uuid())
  name              String
  sku               String  @unique
  description       String?
  basePrice         Float
  model3dUrl        String
  thumbnailUrl      String?
  customizableParts String?
  availableColors   String?
  discountRules     String?

  storeId          String?
  store            Store?      @relation(fields: [storeId], references: [id])
  estimatedTimeMin Int         @default(0)
  orderItems       OrderItem[]
  createdAt        DateTime    @default(now())
}

model Order {
  id          Int @id @default(autoincrement())
  orderNumber Int @default(autoincrement())

  totalAmount    Float
  discountAmount Float @default(0.0)
  finalAmount    Float @default(0.0)

  paymentMethod  String @default("PIX")
  status         String @default("QUOTE")
  productionStep String @default("AGUARDANDO")

  pdfUrl        String?
  receiptPdfUrl String?
  expiresAt     DateTime?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  storeId String
  store   Store? @relation(fields: [storeId], references: [id])

  sellerId String?
  seller   User?   @relation("SellerOrders", fields: [sellerId], references: [id])

  sellerCommission     Float       @default(0.0)
  productionStartedAt  DateTime?
  productionFinishedAt DateTime?
  items                OrderItem[]
  createdAt            DateTime    @default(now())
}

model OrderItem {
  id            String  @id @default(uuid())
  orderId       Int
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  configuration String? @db.Text
  productId     String
  product       Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity      Int
  unitPrice     Float
  totalPrice    Float
}
